# GrailKits environment template
# Copy this file to .env and fill in your own values before running docker compose.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=change_me_postgres
DB_NAME=grailkits_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://root:change_me_postgres@postgres:5432/grailkits_db

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=change_me_mongo
MONGODB_URI=mongodb://root:change_me_mongo@mongo:27017/grailkits?authSource=admin

# Redis
REDIS_PASSWORD=change_me_redis

# Service ports
PORT=3000

# Gateway service targets (internal Docker network)
CATALOG_SERVICE_URL=http://catalog-service:3001
REVIEW_SERVICE_URL=http://review-service:3002
ORDER_SERVICE_URL=http://order-service:3003
