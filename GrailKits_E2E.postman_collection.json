{
  "info": {
    "name": "GrailKits E2E",
    "description": "Kompletny scenariusz end-to-end: przeglądanie katalogu → koszyk → zamówienie → recenzja → moderacja → weryfikacja hybrid write-back.\n\nGateway (port 3000) routing:\n  /api/v1/catalog           → catalog-service /api/v1/products\n  /api/v1/products/:id → catalog-service /api/v1/products/:id\n  /api/v1/reviews/...       → review-service (1:1)\n  /api/v1/orders /cart /checkout → order-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3000", "type": "string" },
    { "key": "userId",    "value": "user-kuba-01",          "type": "string" },
    { "key": "productId", "value": "",                      "type": "string" },
    { "key": "variantId", "value": "",                      "type": "string" },
    { "key": "orderId",   "value": "",                      "type": "string" },
    { "key": "reviewId",  "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "Gateway health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Catalog Service health (bezpośrednio)",
          "request": { "method": "GET", "url": "http://localhost:3001/health" }
        },
        {
          "name": "Order Service health (bezpośrednio)",
          "request": { "method": "GET", "url": "http://localhost:3003/health" }
        },
        {
          "name": "Review Service health (bezpośrednio)",
          "request": { "method": "GET", "url": "http://localhost:3002/health" }
        }
      ]
    },
    {
      "name": "1. Katalog produktów",
      "item": [
        {
          "name": "1.1 Lista produktów",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('Zwraca tablicę', () => pm.expect(Array.isArray(products)).to.be.true);",
                  "if (products.length > 0) {",
                  "  pm.collectionVariables.set('productId', products[0].id);",
                  "  console.log('✅ productId =', products[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Gateway: /api/v1/catalog → catalog-service /api/v1/products\nTest script zapisuje productId pierwszego produktu do zmiennej kolekcji."
          }
        },
        {
          "name": "1.2 Szczegóły produktu (Prisma + $queryRaw)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json();",
                  "pm.test('Produkt ma id', () => pm.expect(product).to.have.property('id'));",
                  "if (product.variants && product.variants.length > 0) {",
                  "  pm.collectionVariables.set('variantId', product.variants[0].id);",
                  "  console.log('✅ variantId =', product.variants[0].id);",
                  "} else {",
                  "  console.warn('⚠️ Brak wariantów – sprawdź seedy katalogu');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Gateway: /api/v1/products/:id → catalog-service /api/v1/products/:id\nZwraca szczegóły z wariantami. Test script zapisuje variantId."
          }
        },
        {
          "name": "1.3 Kategorie (pg raw driver)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/categories",
            "description": "Gateway: /api/v1/products/categories → catalog-service /api/v1/categories\nUżywa surowego pg drivera (T1)."
          }
        }
      ]
    },
    {
      "name": "2. Koszyk",
      "item": [
        {
          "name": "2.1 Dodaj do koszyka (Knex)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id",    "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/cart/lines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}"
            },
            "description": "Dodaje wariant do koszyka. Implementacja: Knex query builder (T2)."
          }
        },
        {
          "name": "2.2 Podgląd koszyka",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-user-id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/cart",
            "description": "Zwraca zawartość koszyka dla zalogowanego użytkownika."
          }
        }
      ]
    },
    {
      "name": "3. Zamówienie",
      "item": [
        {
          "name": "3.1 Checkout → zamówienie (Sequelize + SELECT FOR UPDATE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "if (order.id) {",
                  "  pm.collectionVariables.set('orderId', order.id);",
                  "  console.log('✅ orderId =', order.id);",
                  "}",
                  "pm.test('Zamówienie ma status', () => {",
                  "  pm.expect(['PAID','PENDING']).to.include(order.status);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id",    "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/checkout",
            "description": "⭐ Pesymistyczny lock: SELECT ... FOR UPDATE na wariancie.\nDekrement stocku + zapis zamówienia w jednej transakcji Sequelize (T3)."
          }
        },
        {
          "name": "3.2 Szczegóły zamówienia",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.test('Zamówienie należy do użytkownika', () => {",
                  "  pm.expect(o.userId).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "3.3 Lista zamówień użytkownika",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "3.4 [opcja] Anuluj zamówienie (kompensacja stocku)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status CANCELLED', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
            "description": "Anuluje zamówienie i przywraca stock (kompensacja transakcyjna). 409 przy próbie podwójnego anulowania."
          }
        }
      ]
    },
    {
      "name": "4. Recenzje",
      "item": [
        {
          "name": "4.1 Dodaj recenzję (Mongoose)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Status PENDING', () => pm.expect(r.status).to.eql('PENDING'));",
                  "const id = r._id || r.id;",
                  "if (id) {",
                  "  pm.collectionVariables.set('reviewId', id);",
                  "  console.log('✅ reviewId =', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"userId\": \"{{userId}}\",\n  \"rating\": 5,\n  \"title\": \"Świetny produkt!\",\n  \"body\": \"Bardzo dobra jakość, polecam wszystkim.\"\n}"
            },
            "description": "Tworzy recenzję w MongoDB (status: PENDING).\nMongoose: schema validation + pre-save hook (moderationHistory) + index compound."
          }
        },
        {
          "name": "4.2 Recenzje produktu",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reviews/product/{{productId}}",
            "description": "Mongoose virtual populate z ProductDetail (T5/T6)."
          }
        },
        {
          "name": "4.3 Tylko zatwierdzone (Mongoose static)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reviews/approved?productId={{productId}}",
            "description": "reviewSchema.statics.getApproved() — filtruje APPROVED, sortuje createdAt desc."
          }
        }
      ]
    },
    {
      "name": "5. Moderacja + Hybrid Write-Back",
      "item": [
        {
          "name": "5.1 ⭐ Zatwierdź recenzję → hybrid write-back",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Status APPROVED', () => pm.expect(r.status).to.eql('APPROVED'));",
                  "pm.test('moderationHistory zawiera wpis', () => {",
                  "  pm.expect(r.moderationHistory).to.be.an('array').with.length.above(0);",
                  "});",
                  "pm.test('moderatorId zapisany', () => {",
                  "  const last = r.moderationHistory[r.moderationHistory.length - 1];",
                  "  pm.expect(last.moderatorId).to.eql('mod-admin-01');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/moderate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"moderatorId\": \"mod-admin-01\",\n  \"reason\": \"Recenzja zgodna z regulaminem.\"\n}"
            },
            "description": "⭐ KLUCZOWY FLOW na obronie:\n1. Zapis APPROVED w MongoDB (Mongoose)\n2. Agregacja $group → avg_rating + review_count\n3. UPDATE products w PostgreSQL\nJeśli PG zawiedzie → kompensacja: MongoDB wraca do PENDING."
          }
        },
        {
          "name": "5.2 ✅ Weryfikacja hybrid write-back (avg_rating w PG)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json();",
                  "pm.test('avg_rating ustawione', () => {",
                  "  pm.expect(product.avg_rating).to.not.be.null;",
                  "  pm.expect(Number(product.avg_rating)).to.be.above(0);",
                  "});",
                  "pm.test('review_count >= 1', () => {",
                  "  pm.expect(product.review_count).to.be.at.least(1);",
                  "});",
                  "console.log('avg_rating:', product.avg_rating, '| review_count:', product.review_count);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "description": "Weryfikuje że hybrid write-back zadziałał — avg_rating i review_count zaktualizowane w PostgreSQL."
          }
        },
        {
          "name": "5.3 Analytics — ranking produktów (MongoDB aggregation)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/reviews/analytics/avg-rating",
            "description": "Pipeline: $match(APPROVED) → $group(avg, count) → $lookup(ProductDetail) → $unwind → $sort."
          }
        },
        {
          "name": "5.4 Odrzuć recenzję (REJECTED — brak write-back)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/moderate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"moderatorId\": \"mod-admin-01\",\n  \"reason\": \"Niezgodne z regulaminem.\"\n}"
            },
            "description": "Odrzuca recenzję — hybrid write-back NIE jest wywoływany (tylko APPROVED go triggeruje)."
          }
        }
      ]
    },
    {
      "name": "6. Edge Cases (błędy)",
      "item": [
        {
          "name": "6.1 Cudze zamówienie → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-user-id", "value": "hacker-99" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "6.2 Brak x-user-id → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "6.3 HTML w body recenzji → 400 (Mongoose validator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"userId\": \"{{userId}}\",\n  \"rating\": 5,\n  \"title\": \"XSS test\",\n  \"body\": \"<script>alert('xss')</script>\"\n}"
            }
          }
        },
        {
          "name": "6.4 Podwójna moderacja → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/reviews/{{reviewId}}/moderate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"moderatorId\": \"mod-admin-01\",\n  \"reason\": \"Ponowna próba.\"\n}"
            }
          }
        },
        {
          "name": "6.5 Nieistniejące zamówienie → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders/00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "name": "6.6 Podwójne anulowanie → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user-id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
            "description": "Uruchom po 3.4 — próba ponownego anulowania już CANCELLED zamówienia."
          }
        }
      ]
    }
  ]
}
